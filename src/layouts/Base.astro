---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../config';
import { absolute, breadcrumbList } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; path: string }[];
  schema?: object[];
  bodyClass?: string;
}

const { title, description, path, noindex = false, breadcrumbs = [], schema = [], bodyClass = '' } = Astro.props;
const canonical = absolute(path);
const fullTitle = path === '/' ? `${site.name}: ${site.tagline}` : `${title} | ${site.name}`;
const graph = [...(breadcrumbs.length > 1 ? [breadcrumbList(breadcrumbs)] : []), ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;700;900&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,500&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap.xml" />
    {graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    {
      site.showDraftBadges && (
        <div class="draftbar">
          Working draft: facts are placeholders pending verification with our travel partner, and photos are placeholders.
        </div>
      )
    }
    <Header />
    {breadcrumbs.length > 1 && <Breadcrumbs items={breadcrumbs} />}
    <slot />
    <Footer />
    <script is:inline src="/tracking.js" defer></script>
  </body>
</html>
