---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" path="/404/" description="This page does not exist." noindex>
  <main id="main" class="wrap">
    <header class="page-head">
      <span class="eyebrow">404</span>
      <h1>That page is not here</h1>
      <p class="lede">Try the surf guide, or head back home.</p>
      <p><a class="btn btn-primary" href="/surf/">Surf Costa Rica</a> <a class="btn btn-ghost" href="/">Home</a></p>
    </header>
  </main>
</Base>
