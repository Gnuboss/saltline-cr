---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Request sent"
  path="/quote/thanks/"
  description="Your trip request has been sent."
  noindex
>
  <main id="main" class="wrap">
    <header class="page-head">
      <span class="eyebrow">Request sent</span>
      <h1>Thanks, we have it</h1>
      <p class="lede">Your request is on its way to our Costa Rica travel partner. Expect a reply by email.</p>
      <p><a class="btn btn-primary" href="/surf/">Keep exploring surf</a></p>
    </header>
  </main>
</Base>
