---
import Base from '../layouts/Base.astro';
---
<Base title="You're on the list" path="/subscribed/" description="Your email signup was received." noindex>
  <main id="main" class="wrap">
    <header class="page-head">
      <span class="eyebrow">Signed up</span>
      <h1>You're on the list</h1>
      <p class="lede">Thanks. We will send occasional seasonal notes and trip ideas.</p>
      <p><a class="btn btn-primary" href="/surf/">Keep exploring surf</a></p>
    </header>
  </main>
</Base>
